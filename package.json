{
  "name": "with-tariffs-wide-open",
  "version": "1.1.0",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node --max-old-space-size=2048 dist/deploy-commands.js && node --max-old-space-size=2048 dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:generate-data": "ts-node src/scripts/generateTestData.ts",
    "test:view-data": "ts-node src/scripts/viewTestData.ts",
    "test:integration": "jest tests/integration",
    "test:live-scrape": "ts-node src/scripts/testLiveScrape.ts",
    "test:trigger-cron": "ts-node src/scripts/testTriggerCron.ts",
    "test:trigger-notif": "ts-node src/scripts/testTriggerNotification.ts",
    "test:full-flow": "ts-node src/scripts/testFullFlow.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^22.13.9",
    "axios": "^1.8.2",
    "cheerio": "^1.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "discord.js": "^14.18.0",
    "node-cron": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node-cron": "^3.0.11",
    "dotenv": "^16.4.7",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.4"
  }
}
